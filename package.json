{
  "name": "app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.ts",
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "node node_modules/typescript7/bin/tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @app/db migrate",
    "storybook": "pnpm --filter @app/web storybook",
    "e2e": "pnpm --filter @app/e2e e2e"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.38.2",
    "@eslint/js": "10.0.1",
    "@types/node": "catalog:",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "eslint-plugin-storybook": "10.6.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "catalog:",
    "typescript-eslint": "8.73.0",
    "typescript7": "npm:typescript@7.0.2",
    "vitest": "catalog:"
  }
}
