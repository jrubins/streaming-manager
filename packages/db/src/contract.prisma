// use prisma-8

// Data contract: the source of truth for the database schema.
// After editing: `pnpm --filter @app/db emit`, then `pnpm --filter @app/db migration:plan`.

enum ServiceStatus {
  @@type("pg/text@1")
  active = "active"
  paused = "paused"
}

enum PriceSource {
  @@type("pg/text@1")
  catalog = "catalog"
  manual  = "manual"
  invoice = "invoice"
}

enum MediaType {
  @@type("pg/text@1")
  tv    = "tv"
  movie = "movie"
}

// Owns all data. Members sign in separately and share its services and watchlist.
model Household {
  id         Int                @id @default(autoincrement())
  name       String
  // ISO 3166-1 alpha-2 country: which country's streaming catalogs apply.
  region     String             @default("US")
  // Shared with people who should join this household.
  inviteCode String             @unique
  // Preferences: the plan is the cheapest set of plans that meets them.
  allowAds           Boolean    @default(true)
  minStreams         Int        @default(1)
  require4k          Boolean    @default(false)
  requireDownloads   Boolean    @default(false)
  suggestNewServices Boolean    @default(true)
  // Keys of memberships with streaming perks (an internet provider, a phone plan, Walmart+).
  memberships        String[]   @default([])
  // Keys of the live channels and league passes the household needs.
  channels           String[]   @default([])
  createdAt  DateTime           @default(now()) @onCreate(now())
  updatedAt  temporal.UpdatedAt
  members    HouseholdMember[]
  services   Service[]
  shows      WatchlistShow[]
}

// A signed-in user's (WorkOS `sub`) membership. A user belongs to one household at a time.
model HouseholdMember {
  userId      String    @id
  householdId Int
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  displayName String?
  joinedAt    DateTime  @default(now()) @onCreate(now())

  @@index([householdId, joinedAt])
}

// A streaming service (or bundle of services) the household subscribes to, active or paused.
model Service {
  id                Int                @id @default(autoincrement())
  householdId       Int
  household         Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  // Catalog key: a normalized provider key ("netflix") or a bundle's key (see
  // apps/api/src/features/catalog).
  providerKey       String
  name              String
  logoPath          String?
  planName          String?
  monthlyPriceCents Int?
  priceSource       PriceSource?
  status            ServiceStatus
  // Set when it comes free or discounted with something else: what provides it ("Xfinity"),
  // the price while it lasts, and its last day (YYYY-MM-DD, null when it doesn't end).
  // monthlyPriceCents stays the regular price, paid once the perk ends.
  perkVia           String?
  perkPriceCents    Int?
  perkEndsOn        String?
  // Kept whatever the list needs: used for more than the list (YouTube videos, say).
  alwaysKeep        Boolean            @default(false)
  createdAt         DateTime           @default(now()) @onCreate(now())
  updatedAt         temporal.UpdatedAt

  @@unique([householdId, providerKey])
}

// A show or movie on the household's watchlist.
model WatchlistShow {
  id                   Int                @id @default(autoincrement())
  householdId          Int
  household            Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tmdbId               Int
  mediaType            MediaType
  title                String
  year                 Int?
  posterPath           String?
  watched              Boolean            @default(false)
  // Provider keys it streams on by subscription in `providersRegion`.
  providerKeys         String[]
  providersRegion      String
  providersRefreshedAt DateTime
  addedByUserId        String
  createdAt            DateTime           @default(now()) @onCreate(now())
  updatedAt            temporal.UpdatedAt

  @@unique([householdId, mediaType, tmdbId])
  @@index([householdId, createdAt])
}
