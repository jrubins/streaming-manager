  {
    "id": "table.Item",
    "label": "Create table \"Item\"",
    "summary": "Creates table \"Item\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "Item"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"Item\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"Item\""
        ],
        "expectation": {
          "expects": "absent",
          "object": "table \"Item\""
        }
      }
    ],
    "execute": [
      {
        "description": "create table \"Item\"",
        "sql": "CREATE TABLE \"public\".\"Item\" (\n  \"createdAt\" timestamptz(3) DEFAULT (now()) NOT NULL,\n  \"id\" SERIAL NOT NULL,\n  \"name\" text NOT NULL,\n  \"updatedAt\" timestamptz(3) NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"Item\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_class\" AS \"c\" WHERE (\"c\".\"oid\" = to_regclass($1) AND (\"c\".\"relkind\" = $2 OR \"c\".\"relkind\" = $3))) AS \"result\"",
        "params": [
          "\"public\".\"Item\"",
          "r",
          "p"
        ],
        "expectation": {
          "expects": "present",
          "object": "table \"Item\""
        }
      }
    ]
  }
]