# Non-secret settings for the Prisma CLI, loaded by the `prisma` script in package.json.
# Opt out of anonymous CLI telemetry (on by default in Prisma 8).
PRISMA_DISABLE_TELEMETRY=1
# Prisma's agent skill is installed by pnpm (`permissions` in pnpm-workspace.yaml) as a link
# into the installed package, so it always matches. The CLI's own check only knows about
# `prisma skills sync`, and would otherwise warn on every command.
PRISMA_SKILLS_CHECK=0
